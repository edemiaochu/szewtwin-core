            <GeneralCustomAttribute xmlns="ComprehensiveSchema.01.00.00"/>
            <CustomStructClassAttribute xmlns="ComprehensiveSchema.01.00.00"/>
            <CustomAnyClassAttribute xmlns="ComprehensiveSchema.01.00.00"/>
