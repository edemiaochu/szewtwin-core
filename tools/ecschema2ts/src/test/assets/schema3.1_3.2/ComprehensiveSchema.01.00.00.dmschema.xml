        <DMProperty propertyName="StructStringPrimitive" typeName="string"/>
        <DMProperty propertyName="StructBinaryPrimitive" typeName="binary" readOnly="true"/>
        <DMProperty propertyName="StructDateTimePrimitive" typeName="dateTime" readOnly="true"/>
        <DMProperty propertyName="StructDoublePrimitive" typeName="double"/>
        <DMProperty propertyName="StructIGeometryPrimitive" typeName="Szewec.Geometry.Common.IGeometry"/>
    </DMStructClass>
    <DMStructClass typeName="DerivedStruct" displayLabel="A Struct derived from a Struct">
        <BaseClass>Struct</BaseClass>
    </DMStructClass>
    <DMCustomAttributeClass typeName="CustomEntityClassAttribute" description="Custom Attribute that can be applied to an DMEntityClass." appliesTo="EntityClass">
        <DMProperty propertyName="EntityClassStringPrimitive" typeName="string"/>
        <DMProperty propertyName="EntityClassBinaryPrimitive" typeName="binary" readOnly="true"/>
        <DMProperty propertyName="EntityClassDateTimePrimitive" typeName="dateTime" readOnly="true"/>
        <DMProperty propertyName="EntityClassDoublePrimitive" typeName="double"/>
        <DMProperty propertyName="EntityClassIGeometryPrimitive" typeName="Szewec.Geometry.Common.IGeometry"/>
