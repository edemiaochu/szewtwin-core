    <DMCustomAttributeClass typeName="CustomStructArrayPropertyAttribute" description="Custom Attribute that can be applied to an DMStructArrayProperty." appliesTo="StructArrayProperty"/>
    <DMCustomAttributeClass typeName="CustomStructPropertyAttribute" description="Custom Attribute that can be applied to an DMStructProperty." appliesTo="StructProperty"/>
