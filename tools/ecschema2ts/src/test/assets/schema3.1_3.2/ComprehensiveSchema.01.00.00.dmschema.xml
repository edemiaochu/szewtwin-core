<?xml version="1.0" encoding="UTF-8"?>
<DMSchema schemaName="ComprehensiveSchema" alias="ecsc" version="01.00.00" description="Comprehensive Schema to demonstrate use of all DMSchema concepts." displayLabel="Comprehensive Schema" xmlns="http://www.szewec.com/schemas/Szewec.DMXML.3.2">
    <DMSchemaReference name="CoreCustomAttributes" version="01.00.00" alias="CoreCA"/>
