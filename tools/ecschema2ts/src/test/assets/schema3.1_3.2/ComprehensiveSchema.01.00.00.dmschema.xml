        <DMStructArrayProperty propertyName="CAStructArrayProperty" typeName="Struct" minOccurs="0" maxOccurs="unbounded"/>
    </DMCustomAttributeClass>
    <DMEntityClass typeName="NormalEntityClass" description="Normal class with no modifier">
        <DMCustomAttributes>
            <CustomEntityClassAttribute xmlns="ComprehensiveSchema.01.00.00">
                <CAStructProperty/>
            </CustomEntityClassAttribute>
            <GeneralCustomAttribute xmlns="ComprehensiveSchema.01.00.00"/>
        </DMCustomAttributes>
        <DMProperty propertyName="Property1" typeName="int"/>
    </DMEntityClass>
    <DMRelationshipClass typeName="BaseEntityReferNormal" modifier="Abstract" strength="referencing">
        <Source multiplicity="(0..*)" roleLabel="refers to" polymorphic="true">
            <Class class="BaseEntity"/>
        </Source>
        <Target multiplicity="(0..1)" roleLabel="is referred to by" polymorphic="true">
            <Class class="NormalEntityClass"/>
        </Target>
    </DMRelationshipClass>
    <DMCustomAttributeClass typeName="ClassCustomAttribute" description="Custom Attribute that can only be applied to classes." appliesTo="AnyClass">
        <DMProperty propertyName="Primitive" typeName="string"/>
    </DMCustomAttributeClass>
    <DMCustomAttributeClass typeName="CustomAnyPropertyAttribute" description="Custom Attribute that can be applied to any of the property types." appliesTo="AnyProperty"/>
    <DMCustomAttributeClass typeName="CustomArrayPropertyAttribute" description="Custom Attribute that can be applied to an DMArrayProperty." appliesTo="ArrayProperty"/>
