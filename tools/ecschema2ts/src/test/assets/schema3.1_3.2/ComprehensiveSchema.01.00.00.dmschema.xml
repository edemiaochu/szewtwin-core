        <BaseClass>AbstractEntityClass</BaseClass>
    </DMEntityClass>
    <DMEntityClass typeName="DerivedAbstractSecond" description="A class derived from an abstract class">
        <BaseClass>AbstractEntityClass</BaseClass>
