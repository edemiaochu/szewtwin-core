    <DMCustomAttributeClass typeName="GeneralCustomAttribute" description="Custom Attribute that can be applied to anything." appliesTo="Any"/>
    <DMCustomAttributeClass typeName="SchemaCustomAttribute" description="Custom Attribute that can be applied to a schema." appliesTo="Schema"/>
    <DMCustomAttributes>
        <GeneralCustomAttribute xmlns="ComprehensiveSchema.01.00.00"/>
        <SchemaCustomAttribute xmlns="ComprehensiveSchema.01.00.00"/>
    </DMCustomAttributes>
    <DMEnumeration typeName="IntEnumeration" backingTypeName="int" description="Int Enumeration" displayLabel="This is a display label." isStrict="true">
        <DMEnumerator name="IntEnumeration1" value="1" displayLabel="First"/>
        <DMEnumerator name="IntEnumeration2" value="2" displayLabel="Second"/>
        <DMEnumerator name="IntEnumeration3" value="3" displayLabel="Third"/>
    </DMEnumeration>
    <DMEnumeration typeName="StringEnumeration" backingTypeName="string" description="String Enumeration" isStrict="true">
        <DMEnumerator name="spring" value="spring" displayLabel="FirstSeason"/>
        <DMEnumerator name="summer" value="summer" displayLabel="SecondSeason"/>
        <DMEnumerator name="fall" value="fall" displayLabel="ThirdSeason"/>
        <DMEnumerator name="winter" value="winter" displayLabel="FourthSeason"/>
    </DMEnumeration>
    <DMEntityClass typeName="AbstractEntityClass" description="Abstract class, cannot be instantiated" modifier="Abstract">
        <DMProperty propertyName="AbstractClassProperty1" typeName="dateTime"/>
        <DMNavigationProperty propertyName="FromAbstractToNormalClass" relationshipName="NormalReferAbstractForward" direction="backward"/>
    </DMEntityClass>
    <DMEntityClass typeName="AbstractDerivedAbstract" description="An abstract class derived from an abstract class" modifier="Abstract">
        <BaseClass>AbstractEntityClass</BaseClass>
    </DMEntityClass>
    <DMEntityClass typeName="MixinClass" description="A Mixin is designed to avoid issues with multiple inheritance">
        <DMCustomAttributes>
            <IsMixin xmlns="CoreCustomAttributes.01.00.00">
                <AppliesToEntityClass>BaseEntity</AppliesToEntityClass>
            </IsMixin>
        </DMCustomAttributes>
        <DMProperty propertyName="MixinStringPrimitive" typeName="string"/>
        <DMProperty propertyName="MixinBinaryPrimitive" typeName="binary" readOnly="true"/>
        <DMProperty propertyName="MixinDateTimePrimitive" typeName="dateTime" readOnly="true"/>
        <DMProperty propertyName="MixinDoublePrimitive" typeName="double"/>
        <DMProperty propertyName="MixinIGeometryPrimitive" typeName="Szewec.Geometry.Common.IGeometry"/>
        <DMProperty propertyName="MixinIntPrimitive" typeName="int"/>
        <DMProperty propertyName="MixinLongPrimitive" typeName="long"/>
        <DMProperty propertyName="MixinPoint2dPrimitive" typeName="point2d"/>
        <DMProperty propertyName="MixinPoint3dPrimitive" typeName="point3d"/>
        <DMProperty propertyName="MixinIntEnumerationPrimitive" typeName="IntEnumeration"/>
        <DMProperty propertyName="MixinStringEnumerationPrimitive" typeName="StringEnumeration"/>
    </DMEntityClass>
    <DMEntityClass typeName="BaseEntity" description="Base Entity Description" displayLabel="Base Entity" modifier="Abstract">
        <BaseClass>MixinClass</BaseClass>
        <DMProperty propertyName="InheritedProperty" typeName="string"/>
    </DMEntityClass>
    <DMCustomAttributeClass typeName="CustomStructClassAttribute" description="Custom Attribute that can be applied to an DMStructClass." appliesTo="StructClass"/>
    <DMCustomAttributeClass typeName="CustomAnyClassAttribute" description="Custom Attribute that can be applied to relationshipConstraint." appliesTo="AnyClass"/>
    <DMStructClass typeName="Struct" displayLabel="Struct Class">
