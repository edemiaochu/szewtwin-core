<DMSchema schemaName="SchemaTest" alias="st" version="01.00.00" displayLabel="Test Schema" description="Schema for testing Schema queries" xmlns="http://www.szewec.com/schemas/Szewec.DMXML.3.2">
  <DMSchemaReference name="BisCore" version="01.00.01" alias="bis"/>
  <DMSchemaReference name="CoreCustomAttributes" version="01.00.03" alias="CoreCA"/>

  <DMCustomAttributes>
    <SchemaCustomAttribute xmlns="SchemaTest.01.00.00"/>
  </DMCustomAttributes>

  <DMEntityClass typeName="TestEntity" modifier="Abstract" displayLabel="TestLabel" description="TestDescription">
    <BaseClass>bis:PhysicalElement</BaseClass>
    <DMCustomAttributes>
      <HiddenClass xmlns="CoreCustomAttributes.01.00.03">
        <Show>false</Show>
      </HiddenClass>
      <EntityCustomAttribute xmlns="SchemaTest.01.00.00"/>
    </DMCustomAttributes>
    <DMProperty propertyName="PropertyWithCustomAttribute" typeName="int" displayLabel="PropertyHasAttribute" description="Property has CustomAttribute" >
      <DMCustomAttributes>
        <Localizable xmlns="CoreCustomAttributes.01.00.03"/>
      </DMCustomAttributes>
    </DMProperty>
  </DMEntityClass>

  <DMRelationshipClass typeName="TestEntityReferencesTestEntity" strength="referencing" modifier="None" displayLabel="TestEntityReferencesTestEntity" description="TestEntity references TestEntity">
    <BaseClass>bis:ElementRefersToElements</BaseClass>

    <DMCustomAttributes>
      <RelationshipCustomAttribute xmlns="SchemaTest.01.00.00"/>
    </DMCustomAttributes>

    <Source multiplicity="(0..1)" roleLabel="Owner owns vehicles" polymorphic="true">
      <Class class="TestEntity"/>
      <DMCustomAttributes>
        <ConstraintCustomAttribute xmlns="SchemaTest.01.00.00"/>
      </DMCustomAttributes>
    </Source>

    <Target multiplicity="(0..*)" roleLabel="Vehicle belongs to owner" polymorphic="true">
      <Class class="TestEntity"/>
      <DMCustomAttributes>
        <ConstraintCustomAttribute xmlns="SchemaTest.01.00.00"/>
      </DMCustomAttributes>
    </Target>
  </DMRelationshipClass>

  <DMEnumeration typeName="StringEnumeration" backingTypeName="string" isStrict="false" displayLabel="String Enumeration" description="Test Enumeration">
    <DMEnumerator value="alpha" name="Alpha" displayLabel="First" description="Alpha description"/>
    <DMEnumerator value="beta" name="Beta" displayLabel="Second" description="Beta description"/>
    <DMEnumerator value="omega" name="Omega" displayLabel="Last" description="Omega description"/>
  </DMEnumeration>

  <PropertyCategory typeName="PropertyCategory1" priority="1" displayLabel="TestCategory1" description="Test PropertyCategory1" />

  <DMCustomAttributeClass typeName="EntityCustomAttribute" appliesTo="EntityClass" modifier="Sealed"/>
  <DMCustomAttributeClass typeName="RelationshipCustomAttribute" appliesTo="RelationshipClass" modifier="Sealed"/>
  <DMCustomAttributeClass typeName="SchemaCustomAttribute" appliesTo="Schema" modifier="Sealed"/>
  <DMCustomAttributeClass typeName="ConstraintCustomAttribute" appliesTo="AnyRelationshipConstraint" modifier="Sealed"/>
</DMSchema>