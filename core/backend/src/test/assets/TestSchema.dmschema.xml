<?xml version="1.0" encoding="UTF-8"?>
<DMSchema schemaName="TestSchema" alias="ts" version="01.00.00" description="Comprehensive Schema to demonstrate use of all DMSchema concepts." displayLabel="Comprehensive Schema" xmlns="http://www.szewec.com/schemas/Szewec.DMXML.3.2">

    <DMSchemaReference name="CoreCustomAttributes" version="01.00.00" alias="coreCA"/>

    <DMCustomAttributeClass typeName="CustomEntityClassAttribute" description="Custom Attribute that can be applied to an DMEntityClass." modifier="None" appliesTo="EntityClass">
        <DMProperty propertyName="EntityClassStringPrimitive" typeName="string" readOnly="false"/>
        <DMProperty propertyName="EntityClassBinaryPrimitive" typeName="binary" readOnly="true"/>
        <DMProperty propertyName="EntityClassDateTimePrimitive" typeName="dateTime" readOnly="true"/>
        <DMProperty propertyName="EntityClassDoublePrimitive" typeName="double" readOnly="false"/>
        <DMProperty propertyName="EntityClassIGeometryPrimitive" typeName="Szewec.Geometry.Common.IGeometry" readOnly="false"/>
        <DMProperty propertyName="EntityClassIntPrimitive" typeName="int" readOnly="false"/>
        <DMProperty propertyName="EntityClassLongPrimitive" typeName="long" readOnly="false"/>
        <DMProperty propertyName="EntityClassPoint2dPrimitive" typeName="point2d" readOnly="false"/>
        <DMProperty propertyName="EntityClassPoint3dPrimitive" typeName="point3d" readOnly="false"/>
        <DMProperty propertyName="EntityClassIntEnumerationPrimitive" typeName="IntEnumeration"/>
        <DMProperty propertyName="EntityClassStringEnumerationPrimitive" typeName="StringEnumeration"/>
        <DMStructProperty propertyName="CAStructProperty" typeName="DerivedStruct"/>
        <DMArrayProperty propertyName="CAPrimitiveArrayProperty" typeName="string" minOccurs="0" maxOccurs="unbounded"/>
        <DMStructArrayProperty propertyName="CAStructArrayProperty" typeName="Struct" minOccurs="0" maxOccurs="unbounded"/>
    </DMCustomAttributeClass>
    <DMCustomAttributeClass typeName="GeneralCustomAttribute" description="Custom Attribute that can be applied to anything." modifier="None" appliesTo="Any" />
    <DMCustomAttributeClass typeName="CustomRelationshipConstraintAttribute" description="Custom Attribute that can be applied to relationshipConstraint." modifier="None" appliesTo="AnyRelationshipConstraint" />
    <DMCustomAttributeClass typeName="CustomRelationshipConstraintAttributeSecond" description="Custom Attribute that can be applied to relationshipConstraint." modifier="None" appliesTo="SourceRelationshipConstraint|TargetRelationshipConstraint" />
    <DMCustomAttributeClass typeName="SchemaCustomAttribute" description="Custom Attribute that can be applied to a schema." modifier="None" appliesTo="Schema" />
    <DMCustomAttributeClass typeName="CustomAnyClassAttribute" description="Custom Attribute that can be applied to relationshipConstraint." modifier="None" appliesTo="AnyClass" />
    <DMCustomAttributeClass typeName="CustomCustomAttributeClassAttribute" description="Custom Attribute that can be applied to an DMCustomAttributeClass." modifier="None" appliesTo="CustomAttributeClass" />
    <DMCustomAttributeClass typeName="CustomStructClassAttribute" description="Custom Attribute that can be applied to an DMStructClass." modifier="None" appliesTo="StructClass" />
    <DMCustomAttributeClass typeName="CustomRelationshipClassAttribute" description="Custom Attribute that can be applied to an DMRelationshipClass." modifier="None" appliesTo="RelationshipClass" />
    <DMCustomAttributeClass typeName="CustomPrimitivePropertyAttribute" description="Custom Attribute that can be applied to an DMProperty." modifier="None" appliesTo="PrimitiveProperty" />
    <DMCustomAttributeClass typeName="CustomStructPropertyAttribute" description="Custom Attribute that can be applied to an DMStructProperty." modifier="None" appliesTo="StructProperty" />
    <DMCustomAttributeClass typeName="CustomArrayPropertyAttribute" description="Custom Attribute that can be applied to an DMArrayProperty." modifier="None" appliesTo="ArrayProperty" />
    <DMCustomAttributeClass typeName="CustomStructArrayPropertyAttribute" description="Custom Attribute that can be applied to an DMStructArrayProperty." modifier="None" appliesTo="StructArrayProperty" />
    <DMCustomAttributeClass typeName="CustomNavigationPropertyAttribute" description="Custom Attribute that can be applied to an DMNavigationProperty." modifier="None" appliesTo="NavigationProperty" />
    <DMCustomAttributeClass typeName="CustomAnyPropertyAttribute" description="Custom Attribute that can be applied to any of the property types." modifier="None" appliesTo="AnyProperty" />
    <DMCustomAttributeClass typeName="UsingCustomAttributeClass" description="Custom Attribute class that use an DMCustomAttributeClass">
        <DMCustomAttributes>
            <GeneralCustomAttribute xmlns="TestSchema.01.00.00">
            </GeneralCustomAttribute>
            <CustomCustomAttributeClassAttribute xmlns="TestSchema.01.00.00">
            </CustomCustomAttributeClassAttribute>
            <CustomAnyClassAttribute xmlns="TestSchema.01.00.00">
            </CustomAnyClassAttribute>
        </DMCustomAttributes>
    </DMCustomAttributeClass>
    <DMCustomAttributes>
        <GeneralCustomAttribute xmlns="TestSchema.01.00.00">
        </GeneralCustomAttribute>
        <SchemaCustomAttribute xmlns="TestSchema.01.00.00">
        </SchemaCustomAttribute>
    </DMCustomAttributes>
    <DMEnumeration typeName="IntEnumeration" backingTypeName="int" description="Int Enumeration" displayLabel="This is a display label." strict="true">
        <DMEnumerator value="1" name="First" />
        <DMEnumerator value="2" name="Second"/>
        <DMEnumerator value="3" name="Third"/>
    </DMEnumeration>
    <DMEnumeration typeName="StringEnumeration" backingTypeName="string" description="String Enumeration" strict="false">
        <DMEnumerator value="spring" name="FirstSeason"/>
        <DMEnumerator value="summer" name="SecondSeason"/>
        <DMEnumerator value="fall" name="ThirdSeason"/>
        <DMEnumerator value="winter" name="FourthSeason"/>
    </DMEnumeration>
    <DMEntityClass typeName="NormalEntityClass" description="Normal class with no modifier" modifier="None">
        <DMProperty propertyName="Property1" typeName="int"/>
        <DMCustomAttributes>
            <CustomEntityClassAttribute xmlns="TestSchema.01.00.00">
            </CustomEntityClassAttribute>
            <GeneralCustomAttribute xmlns="TestSchema.01.00.00">
            </GeneralCustomAttribute>
        </DMCustomAttributes>
    </DMEntityClass>

    <DMEntityClass typeName="MixinClass" description="A Mixin is designed to avoid issues with multiple inheritance">
        <DMCustomAttributes>
            <IsMixin xmlns="CoreCustomAttributes.01.00.00">
                <AppliesToEntityClass>BaseEntity</AppliesToEntityClass>
            </IsMixin>
        </DMCustomAttributes>
        <DMProperty propertyName="MixinStringPrimitive" typeName="string" readOnly="false"/>
        <DMProperty propertyName="MixinBinaryPrimitive" typeName="binary" readOnly="true"/>
        <DMProperty propertyName="MixinDateTimePrimitive" typeName="dateTime" readOnly="true"/>
        <DMProperty propertyName="MixinDoublePrimitive" typeName="double" readOnly="false"/>
        <DMProperty propertyName="MixinIGeometryPrimitive" typeName="Szewec.Geometry.Common.IGeometry" readOnly="false"/>
        <DMProperty propertyName="MixinIntPrimitive" typeName="int" readOnly="false"/>
        <DMProperty propertyName="MixinLongPrimitive" typeName="long" readOnly="false"/>
        <DMProperty propertyName="MixinPoint2dPrimitive" typeName="point2d" readOnly="false"/>
        <DMProperty propertyName="MixinPoint3dPrimitive" typeName="point3d" readOnly="false"/>
        <DMProperty propertyName="MixinIntEnumerationPrimitive" typeName="IntEnumeration"/>
        <DMProperty propertyName="MixinStringEnumerationPrimitive" typeName="StringEnumeration"/>
    </DMEntityClass>
    <DMEntityClass typeName="DerivedMixin" description="A Mixin class derived from a Mixin class">
        <DMCustomAttributes>
            <IsMixin xmlns="CoreCustomAttributes.01.00.00">
                <AppliesToEntityClass>Entity</AppliesToEntityClass>
            </IsMixin>
        </DMCustomAttributes>
        <BaseClass>MixinClass</BaseClass>
        <DMProperty propertyName="DerivedMixinStringPrimitive" typeName="string" readOnly="false"/>
        <DMProperty propertyName="DerivedMixinBinaryPrimitive" typeName="binary" readOnly="true"/>
        <DMProperty propertyName="DerivedMixinDateTimePrimitive" typeName="dateTime" readOnly="true"/>
        <DMProperty propertyName="DerivedMixinDoublePrimitive" typeName="double" readOnly="false"/>
        <DMProperty propertyName="DerivedMixinIGeometryPrimitive" typeName="Szewec.Geometry.Common.IGeometry" readOnly="false"/>
        <DMProperty propertyName="DerivedMixinIntPrimitive" typeName="int" readOnly="false"/>
        <DMProperty propertyName="DerivedMixinLongPrimitive" typeName="long" readOnly="false"/>
        <DMProperty propertyName="DerivedMixinPoint2dPrimitive" typeName="point2d" readOnly="false"/>
        <DMProperty propertyName="DerivedMixinPoint3dPrimitive" typeName="point3d" readOnly="false"/>
    </DMEntityClass>

    <DMEntityClass typeName="DerivedNormal" description="A class derived from a normal class">
        <BaseClass>NormalEntityClass</BaseClass>
        <DMProperty propertyName="DerivedProperty1" typeName="string"/>
    </DMEntityClass>
    <DMEntityClass typeName="AbstractEntityClass" description="Abstract class, cannot be instantiated" modifier="Abstract">
        <DMProperty propertyName="AbstractClassProperty1" typeName="dateTime"/>
        <DMNavigationProperty propertyName="FromAbstractToNormalClass" relationshipName="NormalReferAbstractForward" direction="backward"/>
    </DMEntityClass>
    <DMEntityClass typeName="SealedEntityClass" description="Instantiable, but cannot be used as base class" modifier="Sealed">
        <DMProperty propertyName="SealedClassProperty1" typeName="boolean"/>
    </DMEntityClass>
    <DMEntityClass typeName="SealedDerivedNormal" description="A sealed class derived from a normal class" modifier="Sealed">
        <BaseClass>NormalEntityClass</BaseClass>
    </DMEntityClass>
    <DMEntityClass typeName="DerivedNormalSecond" description="A class derived from a normal class">
        <BaseClass>NormalEntityClass</BaseClass>
        <DMProperty propertyName="DerivedProperty2" typeName="long"/>
    </DMEntityClass>
    <DMEntityClass typeName="AbstractDerivedAbstract" description="An abstract class derived from an abstract class" modifier="Abstract">
        <BaseClass>AbstractEntityClass</BaseClass>
    </DMEntityClass>
    <DMEntityClass typeName="SealedDerivedAbstract" description="A sealed class derived from an abstract class" modifier="Sealed">
        <BaseClass>AbstractEntityClass</BaseClass>
    </DMEntityClass>
    <DMEntityClass typeName="DerivedAbstract" description="A class derived from an abstract class">
        <BaseClass>AbstractEntityClass</BaseClass>
    </DMEntityClass>
    <DMEntityClass typeName="DerivedAbstractSecond" description="A class derived from an abstract class">
        <BaseClass>AbstractEntityClass</BaseClass>
    </DMEntityClass>
    <DMEntityClass typeName="BaseEntity" description="Base Entity Description" displayLabel="Base Entity" modifier="Abstract">
        <BaseClass>MixinClass</BaseClass>
        <DMProperty propertyName="InheritedProperty" typeName="string" readOnly="false" />
    </DMEntityClass>
    <DMCustomAttributeClass typeName="ClassCustomAttribute" description="Custom Attribute that can only be applied to classes." modifier="None" appliesTo="EntityClass, CustomAttributeClass, StructClass, RelationshipClass, AnyClass">
        <DMProperty propertyName="Primitive" typeName="string" readOnly="false" />
    </DMCustomAttributeClass>
    <DMStructClass typeName="Struct" displayLabel="Struct Class" modifier="None">
        <DMProperty propertyName="StructStringPrimitive" typeName="string" readOnly="false"/>
        <DMProperty propertyName="StructBinaryPrimitive" typeName="binary" readOnly="true"/>
        <DMProperty propertyName="StructDateTimePrimitive" typeName="dateTime" readOnly="true"/>
        <DMProperty propertyName="StructDoublePrimitive" typeName="double" readOnly="false"/>
        <DMProperty propertyName="StructIGeometryPrimitive" typeName="Szewec.Geometry.Common.IGeometry" readOnly="false"/>
        <DMProperty propertyName="StructIntPrimitive" typeName="int" readOnly="false"/>
        <DMProperty propertyName="StructLongPrimitive" typeName="long" readOnly="false"/>
        <DMProperty propertyName="StructPoint2dPrimitive" typeName="point2d" readOnly="false"/>
        <DMProperty propertyName="StructPoint3dPrimitive" typeName="point3d" readOnly="false"/>
        <DMProperty propertyName="StructIntEnumerationPrimitive" typeName="IntEnumeration"/>
        <DMProperty propertyName="StructStringEnumerationPrimitive" typeName="StringEnumeration"/>
        <DMCustomAttributes>
            <GeneralCustomAttribute xmlns="TestSchema.01.00.00">
            </GeneralCustomAttribute>
            <CustomStructClassAttribute xmlns="TestSchema.01.00.00">
            </CustomStructClassAttribute>
            <CustomAnyClassAttribute xmlns="TestSchema.01.00.00">
            </CustomAnyClassAttribute>
        </DMCustomAttributes>
    </DMStructClass>
    <DMStructClass typeName="DerivedStruct" displayLabel="A Struct derived from a Struct">
        <BaseClass>Struct</BaseClass>
    </DMStructClass>
    <DMEntityClass typeName="Entity" modifier="None">
        <BaseClass>BaseEntity</BaseClass>
        <BaseClass>DerivedMixin</BaseClass>
        <DMProperty propertyName="InheritedProperty" typeName="string" readOnly="false" description="A property override." />
    </DMEntityClass>

    <DMEntityClass typeName="PropertyCollection" modifier="Sealed">
        <DMCustomAttributes>
            <ClassCustomAttribute xmlns="TestSchema.01.00.00">
                <Primitive>General Value on Class</Primitive>
            </ClassCustomAttribute>
            <CustomAnyClassAttribute xmlns="TestSchema.01.00.00">
            </CustomAnyClassAttribute>
        </DMCustomAttributes>
        <DMProperty propertyName="PropCollectionBinaryPrimitive" typeName="binary" displayLabel="Property Display Label" readOnly="false"/>
        <DMProperty propertyName="PropCollectionBooleanPrimitive" typeName="boolean" description="Property Description" readOnly="false"/>
        <DMProperty propertyName="PropCollectionDateTimePrimitive" typeName="dateTime" readOnly="true"/>
        <DMProperty propertyName="PropCollectionDoublePrimitive" typeName="double" minimumValue="2.3" maximumValue="9.6" readOnly="false"/>
        <DMProperty propertyName="PropCollectionIGeometryPrimitive" typeName="Szewec.Geometry.Common.IGeometry" readOnly="false"/>
        <DMProperty propertyName="PropCollectionIntPrimitive" typeName="int" readOnly="false" minimumValue="0" maximumValue="10000"/>
        <DMProperty propertyName="PropCollectionLongPrimitive" typeName="long" readOnly="false"/>
        <DMProperty propertyName="PropCollectionPoint2dPrimitive" typeName="point2d" readOnly="false"/>
        <DMProperty propertyName="PropCollectionPoint3dPrimitive" typeName="point3d" readOnly="false"/>
        <DMProperty propertyName="PropCollectionStringPrimitive" typeName="string" readOnly="false"/>
        <DMProperty propertyName="IntEnumerationPrimitive" typeName="IntEnumeration"/>
        <DMProperty propertyName="StringEnumerationPrimitive" typeName="StringEnumeration"/>
        <DMProperty propertyName="PropertyWithCustomAttribute" typeName="string">
            <DMCustomAttributes>
                <CustomPrimitivePropertyAttribute xmlns="TestSchema.01.00.00">
                </CustomPrimitivePropertyAttribute>
                <CustomAnyPropertyAttribute xmlns="TestSchema.01.00.00">
                </CustomAnyPropertyAttribute>
                <GeneralCustomAttribute xmlns="TestSchema.01.00.00">
                </GeneralCustomAttribute>
            </DMCustomAttributes>
        </DMProperty>
        <DMArrayProperty propertyName="LongArray" typeName="long" readOnly="false" minOccurs="0" maxOccurs="unbounded"/>
        <DMArrayProperty propertyName="BinaryArray" typeName="binary" readOnly="false" minOccurs="1" maxOccurs="unbounded"/>
        <DMArrayProperty propertyName="BooleanArray" typeName="boolean" readOnly="true" minOccurs="0" maxOccurs="10">
            <DMCustomAttributes>
                <CustomArrayPropertyAttribute xmlns="TestSchema.01.00.00">
                </CustomArrayPropertyAttribute>
                <CustomAnyPropertyAttribute xmlns="TestSchema.01.00.00">
                </CustomAnyPropertyAttribute>
                <GeneralCustomAttribute xmlns="TestSchema.01.00.00">
                </GeneralCustomAttribute>
            </DMCustomAttributes>
        </DMArrayProperty>
        <DMArrayProperty propertyName="DateTimeArray" typeName="dateTime" readOnly="true" minOccurs="1" maxOccurs="10"/>
        <DMArrayProperty propertyName="DoubleArray" typeName="double" readOnly="false" minOccurs="5" maxOccurs="5"/>
        <DMArrayProperty propertyName="IGeometryArray" typeName="Szewec.Geometry.Common.IGeometry" readOnly="false" minOccurs="2" maxOccurs="100"/>
        <DMArrayProperty propertyName="IntArray" typeName="int" readOnly="true" minOccurs="0" maxOccurs="unbounded" />
        <DMArrayProperty propertyName="Point2dArray" typeName="point2d" readOnly="false" minOccurs="3" maxOccurs="3"/>
        <DMArrayProperty propertyName="Point3dArray" typeName="point3d" readOnly="true" minOccurs="0" maxOccurs="unbounded"/>
        <DMArrayProperty propertyName="StringArray" typeName="string" readOnly="true" minOccurs="1" maxOccurs="15"/>
        <DMStructProperty propertyName="Struct1" typeName="Struct" readOnly="false">
            <DMCustomAttributes>
                <CustomStructPropertyAttribute xmlns="TestSchema.01.00.00">
                </CustomStructPropertyAttribute>
                <CustomAnyPropertyAttribute xmlns="TestSchema.01.00.00">
                </CustomAnyPropertyAttribute>
                <GeneralCustomAttribute xmlns="TestSchema.01.00.00">
                </GeneralCustomAttribute>
            </DMCustomAttributes>
        </DMStructProperty>
        <DMStructArrayProperty propertyName="StructArray" typeName="Struct" readOnly="false" minOccurs="0" maxOccurs="unbounded">
            <DMCustomAttributes>
                <CustomStructArrayPropertyAttribute xmlns="TestSchema.01.00.00">
                </CustomStructArrayPropertyAttribute>
                <CustomAnyPropertyAttribute xmlns="TestSchema.01.00.00">
                </CustomAnyPropertyAttribute>
                <GeneralCustomAttribute xmlns="TestSchema.01.00.00">
                </GeneralCustomAttribute>
            </DMCustomAttributes>
        </DMStructArrayProperty>
        <DMStructArrayProperty propertyName="StructArraySecond" typeName="Struct" minOccurs="1" maxOccurs="100">
        </DMStructArrayProperty>
        <DMStructArrayProperty propertyName="StructArrayThird" typeName="Struct" minOccurs="4" maxOccurs="4">
        </DMStructArrayProperty>
    </DMEntityClass>

    <DMRelationshipClass typeName="BaseEntityReferNormal" modifier="Abstract" strength="referencing" strengthDirection="forward">
        <Source multiplicity="(0..*)" polymorphic="true" roleLabel="refers to">
            <Class class="BaseEntity"/>
        </Source>
        <Target multiplicity="(0..1)" polymorphic="true" roleLabel="is referred to by">
            <Class class="NormalEntityClass"/>
        </Target>
    </DMRelationshipClass>

    <DMRelationshipClass typeName="EntityReferDerivedNormal" modifier="Sealed" strength="referencing" strengthDirection="forward">
        <BaseClass>BaseEntityReferNormal</BaseClass>
        <Source multiplicity="(0..*)" polymorphic="true" roleLabel="refers to">
            <Class class="Entity"/>
        </Source>
        <Target multiplicity="(0..1)" polymorphic="true" roleLabel="is referred to by">
            <Class class="DerivedNormal"/>
        </Target>
    </DMRelationshipClass>

    <DMRelationshipClass typeName="NormalReferAbstractForward" modifier="Abstract" strength="referencing" strengthDirection="forward">
        <DMCustomAttributes>
            <GeneralCustomAttribute xmlns="TestSchema.01.00.00">
            </GeneralCustomAttribute>
            <CustomRelationshipClassAttribute xmlns="TestSchema.01.00.00">
            </CustomRelationshipClassAttribute>
        </DMCustomAttributes>
        <Source multiplicity="(1..1)" polymorphic="true" roleLabel="refers to" abstractConstraint="NormalEntityClass">
            <Class class="DerivedNormal"/>
            <Class class="NormalEntityClass"/>
            <Class class="SealedDerivedNormal"/>
        </Source>
        <Target multiplicity="(0..*)" polymorphic="false" roleLabel="is referred to by" abstractConstraint="AbstractEntityClass">
            <Class class="AbstractEntityClass"/>
        </Target>
    </DMRelationshipClass>

    <DMRelationshipClass typeName="DerivedRelationshipClass" modifier="Sealed" strength="referencing" strengthDirection="forward">
        <BaseClass>NormalReferMixinForward</BaseClass>
        <Source multiplicity="(1..1)" polymorphic="true" roleLabel="references">
            <Class class="DerivedNormal"/>
        </Source>
        <Target multiplicity="(0..1)" polymorphic="false" roleLabel="is referenced by" abstractConstraint="MixinClass">
            <Class class="DerivedMixin"/>
        </Target>
    </DMRelationshipClass>

    <DMRelationshipClass typeName="NormalReferAbstractBackward" modifier="Abstract" strength="referencing" strengthDirection="backward">
        <Source multiplicity="(1..*)" polymorphic="true" roleLabel="is referred to by">
            <Class class="NormalEntityClass"/>
        </Source>
        <Target multiplicity="(0..1)" polymorphic="false" roleLabel="refers to" abstractConstraint="AbstractEntityClass">
            <Class class="AbstractEntityClass"/>
            <Class class="AbstractDerivedAbstract"/>
            <Class class="DerivedAbstract"/>
            <Class class="DerivedAbstractSecond"/>
        </Target>
    </DMRelationshipClass>

    <DMRelationshipClass typeName="NormalReferMixinForward" modifier="Abstract" strength="referencing" strengthDirection="forward">
        <Source multiplicity="(0..*)" polymorphic="true" roleLabel="references">
            <Class class="NormalEntityClass"/>
        </Source>
        <Target multiplicity="(0..1)" polymorphic="true" roleLabel="is referenced by" abstractConstraint="MixinClass">
            <Class class="DerivedMixin"/>
        </Target>
    </DMRelationshipClass>

    <DMRelationshipClass typeName="SealedHoldNormalForward" modifier="Sealed" strength="holding" strengthDirection="forward">
        <Source multiplicity="(1..1)" polymorphic="true" roleLabel="holds">
            <Class class="SealedEntityClass"/>
        </Source>
        <Target multiplicity="(0..*)" polymorphic="true" roleLabel="is held by" abstractConstraint="NormalEntityClass">
            <Class class="NormalEntityClass"/>
            <Class class="DerivedNormal"/>
            <Class class="SealedDerivedNormal"/>
            <DMCustomAttributes>
                <CustomRelationshipConstraintAttribute xmlns="TestSchema.01.00.00">
                </CustomRelationshipConstraintAttribute>
                <CustomRelationshipConstraintAttributeSecond xmlns="TestSchema.01.00.00">
                </CustomRelationshipConstraintAttributeSecond>
            </DMCustomAttributes>
        </Target>
    </DMRelationshipClass>

    <DMRelationshipClass typeName="SealedHoldNormalBackward" modifier="Abstract" strength="holding" strengthDirection="backward">
        <Source multiplicity="(0..1)" polymorphic="false" roleLabel="is held by">
            <Class class="SealedEntityClass"/>
        </Source>
        <Target multiplicity="(0..1)" polymorphic="true" roleLabel="holds">
            <Class class="NormalEntityClass"/>
            <DMCustomAttributes>
                <CustomRelationshipConstraintAttribute xmlns="TestSchema.01.00.00">
                </CustomRelationshipConstraintAttribute>
                <CustomRelationshipConstraintAttributeSecond xmlns="TestSchema.01.00.00">
                </CustomRelationshipConstraintAttributeSecond>
            </DMCustomAttributes>
        </Target>
    </DMRelationshipClass>
    <DMRelationshipClass typeName="EntityEmbedNormalBackward" modifier="Abstract" strength="embedding" strengthDirection="backward">
        <Source multiplicity="(0..1)" polymorphic="true" roleLabel="is embedded by">
            <Class class="Entity"/>
        </Source>
        <Target multiplicity="(1..*)" polymorphic="true" roleLabel="embeds">
            <Class class="NormalEntityClass"/>
            <DMCustomAttributes>
                <CustomRelationshipConstraintAttribute xmlns="TestSchema.01.00.00">
                </CustomRelationshipConstraintAttribute>
                <CustomRelationshipConstraintAttributeSecond xmlns="TestSchema.01.00.00">
                </CustomRelationshipConstraintAttributeSecond>
            </DMCustomAttributes>
        </Target>
    </DMRelationshipClass>
    <DMRelationshipClass typeName="EntityReferEntity" modifier="Sealed" strength="referencing" strengthDirection="forward">
        <DMProperty propertyName="RelationshipProperty" typeName="string" readOnly="false"/>
        <Source multiplicity="(0..1)" polymorphic="true" roleLabel="references">
            <Class class="Entity"/>
        </Source>
        <Target multiplicity="(0..1)" polymorphic="true" roleLabel="is referenced by">
            <Class class="Entity"/>
        </Target>
    </DMRelationshipClass>
</DMSchema>
