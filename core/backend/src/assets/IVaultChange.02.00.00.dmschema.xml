            <ForeignKeyConstraint xmlns="DMDbMap.02.00.00">
                <OnDeleteAction>Cascade</OnDeleteAction>
            </ForeignKeyConstraint>
        </DMCustomAttributes>
    </DMNavigationProperty>
    <DMProperty propertyName="ParentWsgId" typeName="string">
