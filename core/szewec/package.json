{
  "name": "@szewtwin/core-szewec",
  "version": "5.9.1",
  "description": "Szewec JavaScript core components",
  "main": "lib/cjs/core-szewec.js",
  "module": "lib/esm/core-szewec.js",
  "typings": "lib/cjs/core-szewec",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/szewTwin/szewtwinjs-core.git",
    "directory": "core/szewec"
  },
  "scripts": {
    "build": "npm run -s build:cjs && npm run -s build:esm",
    "build:cjs": "tsc 1>&2 --outDir lib/cjs",
    "build:esm": "tsc 1>&2 --module ES2022 --outDir lib/esm",
    "clean": "rimraf -g lib .rush/temp/package-deps*.json",
    "extract-api": "betools extract-api --entry=core-szewec",
    "test": "vitest --run",
    "docs": "betools docs --json=../../generated-docs/core/core-szewec/file.json --tsIndexFile=core-szewec.ts --onlyJson",
    "cover": "vitest --run --coverage",
    "lint": "eslint \"./src/**/*.ts\" 1>&2",
    "lint-fix": "eslint --fix -f visualstudio \"./src/**/*.ts\" 1>&2",
    "lint-deprecation": "eslint --fix -f visualstudio --no-inline-config -c ../../common/config/eslint/eslint.config.deprecation-policy.js \"./src/**/*.ts\""
  },
  "keywords": [
    "Szewec",
    "iVault",
    "digital-twin",
    "szewTwin"
  ],
  "author": {
    "name": "Szewec Systems, Inc.",
    "url": "http://www.szewec.com"
  },
  "devDependencies": {
    "@szewtwin/build-tools": "workspace:*",
    "@szewtwin/eslint-plugin": "^6.0.0",
    "@opentelemetry/api": "1.0.4",
    "@types/node": "~20.17.0",
    "@vitest/coverage-v8": "^3.0.6",
    "eslint": "^9.31.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.6.2",
    "vitest": "^3.0.6"
  },
  "nyc": {
    "extends": "./node_modules/@szewtwin/build-tools/.nycrc"
  }
}
