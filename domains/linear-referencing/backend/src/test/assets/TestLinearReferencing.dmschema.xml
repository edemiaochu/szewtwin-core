<?xml version="1.0" encoding="UTF-8"?>
<DMSchema schemaName="TestLinearReferencing" alias="testLR" version="1.0.0" xmlns="http://www.szewec.com/schemas/Szewec.DMXML.3.1">
    <DMSchemaReference name="BisCore" version="01.00" alias="bis"/>
    <DMSchemaReference name="LinearReferencing" version="02.00" alias="lr"/>

    <DMEntityClass typeName="TestLinearElement" description="A test class that acts as the LinearElement in this test domain for Linear-Referencing purposes.">
        <BaseClass>bis:SpatialLocationElement</BaseClass>
        <BaseClass>lr:ILinearElement</BaseClass>
    </DMEntityClass>

    <DMEntityClass typeName="TestLinearFeature" description="A test class that acts as a source of LinearElements in this test domain for Linear-Referencing purposes.">
        <BaseClass>bis:PhysicalElement</BaseClass>
        <BaseClass>lr:ILinearElementSource</BaseClass>
    </DMEntityClass>

    <DMEntityClass typeName="TestLinearlyLocatedAttribution" description="A test class that represents an attribution element carrying a value that only applies to a portion of a test linear feature.">
        <BaseClass>lr:LinearlyLocatedAttribution</BaseClass>
        <DMProperty propertyName="TestProperty" typeName="int"/>
    </DMEntityClass>

    <DMEntityClass typeName="TestLinearPhysicalElement" description="A test class that represents physical element inherintly linearly-located.">
        <BaseClass>lr:LinearPhysicalElement</BaseClass>
        <DMProperty propertyName="TestProperty" typeName="boolean"/>
    </DMEntityClass>
</DMSchema>