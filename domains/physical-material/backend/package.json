{
  "name": "@szewtwin/physical-material-backend",
  "version": "5.9.1",
  "main": "lib/cjs/physical-material-backend.js",
  "module": "lib/esm/physical-material-backend.js",
  "typings": "lib/cjs/physical-material-backend",
  "license": "MIT",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "build": "npm run -s build:cjs && npm run -s build:esm",
    "build:cjs": "tsc 1>&2 --outDir lib/cjs",
    "build:esm": "tsc 1>&2 --module ES2022 --outDir lib/esm",
    "clean": "rimraf -g lib .rush/temp/package-deps*.json",
    "cover": "nyc npm -s test",
    "docs": "betools docs --json=../../../generated-docs/domains/physical-material-backend/file.json --tsIndexFile=./physical-material-backend.ts --onlyJson",
    "extract-api": "betools extract-api --entry=physical-material-backend",
    "lint": "eslint \"./src/**/*.ts\" 1>&2",
    "lint-deprecation": "eslint --fix -f visualstudio --no-inline-config -c ../../../common/config/eslint/eslint.config.deprecation-policy.js \"./src/**/*.ts\"",
    "test": "mocha"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/szewTwin/szewtwinjs-core.git",
    "directory": "domains/physical-material/backend"
  },
  "keywords": [
    "Szewec",
    "BIM",
    "iVault"
  ],
  "author": {
    "name": "Szewec Systems, Inc.",
    "url": "http://www.szewec.com"
  },
  "peerDependencies": {
    "@szewtwin/core-backend": "workspace:*",
    "@szewtwin/core-szewec": "workspace:*",
    "@szewtwin/core-common": "workspace:*"
  },
  "//devDependencies": [
    "NOTE: All peerDependencies should also be listed as devDependencies since peerDependencies are not considered by npm install",
    "NOTE: All tools used by scripts in this package must be listed as devDependencies"
  ],
  "devDependencies": {
    "@szewtwin/build-tools": "workspace:*",
    "@szewtwin/core-backend": "workspace:*",
    "@szewtwin/core-szewec": "workspace:*",
    "@szewtwin/core-common": "workspace:*",
    "@szewtwin/eslint-plugin": "^6.0.0",
    "@types/chai": "4.3.1",
    "@types/mocha": "^10.0.6",
    "@types/node": "~20.17.0",
    "chai": "^4.3.10",
    "eslint": "^9.31.0",
    "mocha": "^11.1.0",
    "nyc": "^17.1.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.6.2"
  },
  "nyc": {
    "extends": "./node_modules/@szewtwin/build-tools/.nycrc"
  }
}
